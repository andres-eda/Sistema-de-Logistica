void menu()
{
    //Declaracion de variables 
    int op; //Almacena la opcion seleccionada por el usuario en el menù 

    //Algoritmo:ciclo de control que se ejecuta al menos una vez 
    do 
    {
        //impresion de la interfaz grafica del menù en la consola 
        printf("#####Bienvenido al servicio de paqueteria#####\n");
        printf("Opcion 1: Registrar paquetes\n");
        printf("Opcion 2: Asignacion de paquetes\n");
        printf("Opcion 3: Imprimir lista de entregas\n");
        printf("Opcion 4: Reportes de estado\n");
        printf("Opcion 5: Salir del programa\n");
        //valida que el usuario ingrese un numero entero valido 
        if(scanf("%d", &op)==1)
        {
//evalua la opcion ingresada para mandar a llamar la funcion
            switch(op)
            {
                case 1:    
                //abre el submenu para el registro de los paquetes 
                menuRegisPac();
                break;

                case 2:
                //espacio reservado para la funcion de asignacion de paquetes 
               
                break; 

                case 3:
                 //espacio reservado para imprimir la lista de entregas 
               
                break;

                case 4: 
                //espacio reservado para mostar los reportes de estado 
                
                break; 

                case 5: 
                //mensaje informativo al salir del sistema de forma exitosa
                printf("Usted ha salido del programa con exito");
                break;

                default: 
                //mensaje de error si el numero ingresado no esta entre el 1 y el 5
                puts("Inserte un digito valido");
            }
        }
        else 
        {
            clean();
        }
    }while (op!=5); //el ciclo se repite hasta que el usuario elija la opcion 5
}
